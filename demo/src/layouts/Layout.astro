---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        var saved = localStorage.getItem("theme");
        var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        var dark = saved ? saved === "dark" : prefersDark;
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=DM+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
    <footer class="muted mx-auto p-4 pb-16 text-center text-sm">
      &copy; m snook ❤️ —
      <a class="accent-ink hover:underline" href="https://github.com/mhsnook/tailwind-oklch">github</a> —
      <a class="accent-ink hover:underline" href="https://bsky.app/profile/msnook.xyz">bluesky</a>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        var root = document.documentElement;
        function label() {
          var d = root.classList.contains("dark");
          btn.textContent = d ? "☾ Dark" : "☀ Light";
        }
        btn.addEventListener("click", function () {
          var d = root.classList.toggle("dark");
          localStorage.setItem("theme", d ? "dark" : "light");
          label();
        });
        label();
      })();
    </script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
