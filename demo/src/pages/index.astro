---
import Layout from "@/layouts/Layout.astro";

const wheel = [
  { name: "blue", deg: 245, cs: 0.85 },
  { name: "purple", deg: 300, cs: 0.86 },
  { name: "pink", deg: 350, cs: 0.9 },
  { name: "red", deg: 25, cs: 0.95 },
  { name: "orange", deg: 55, cs: 1.0 },
  { name: "yellow", deg: 100, cs: 1.1 },
  { name: "green", deg: 145, cs: 1.0 },
  { name: "bluegreen", deg: 195, cs: 0.92 },
];
const stops = ["lo", "mlo", "mid", "mhi", "hi"];

const semantic = [
  { name: "primary", deg: 233, cs: 0.86 },
  { name: "info", deg: 220, cs: 0.88 },
  { name: "accent", deg: 350, cs: 0.9 },
  { name: "danger", deg: 15, cs: 0.93 },
  { name: "success", deg: 145, cs: 1.0 },
  { name: "warning", deg: 55, cs: 1.0 },
];
---

<Layout title="tailwind-oklch — a cascade-first OKLCH color system">
  <main class="mx-auto max-w-[960px] px-6 pt-10 pb-8">
    <!-- ── Header ─────────────────────────────────────────────────────── -->
    <header class="flex items-start justify-between gap-4">
      <div>
        <div class="accent-ink font-mono text-xs font-semibold tracking-[0.16em] uppercase">
          Tailwind CSS · OKLCH
        </div>
        <h1 class="mt-2 font-mono text-4xl font-bold tracking-tight sm:text-5xl">
          tailwind-oklch
        </h1>
      </div>
      <button id="theme-toggle" class="toggle shrink-0" type="button">☀ Light</button>
    </header>

    <p class="muted mt-5 max-w-[62ch] text-lg leading-relaxed">
      Compose colors from three independent axes — <b class="accent-ink">luminance</b>,
      <b class="accent-ink">chroma</b>, and <b class="accent-ink">hue</b> — instead of
      hand-picking tokens. Each class states one fact about one axis; hue and chroma
      cascade, so most elements only ever state their luminance. Pure CSS, one
      <span class="kbd">@import</span>, no plugin.
    </p>

    <!-- ── Hero: one item, three characters ──────────────────────────── -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold tracking-tight">One item, three characters</h2>
      <p class="muted mt-1 max-w-[64ch] text-sm leading-relaxed">
        Same component, same class skeleton. The interior speaks only luminance
        (<span class="kbd">text-lc-9</span>, <span class="kbd">bg-lc-6</span>,
        <span class="kbd">border-lc-3</span>); its character — which hue, how loud —
        is seeded once on the wrapper with two words and cascades down.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <!-- primary, middling -->
        <div class="flex flex-col gap-2">
          <div class="kbd self-start">hue-primary chroma-mid</div>
          <article class="card hue-primary chroma-mid">
            <div class="card-eyebrow">Today</div>
            <h3 class="card-title">Continue your lesson</h3>
            <p class="card-body">
              Pick up Unit 4 where you left off. A steady day keeps the schedule on
              track. <a class="card-link" href="#">Read more ›</a>
            </p>
            <div class="card-foot">
              <span class="card-meta">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.3"></circle><line x1="8" y1="7.2" x2="8" y2="11.2"></line><circle cx="8" cy="4.8" r="0.55" fill="currentColor" stroke="none"></circle></svg>
                12 cards due
              </span>
              <button class="card-btn" type="button">Start review</button>
            </div>
          </article>
        </div>

        <!-- warning, subtle -->
        <div class="flex flex-col gap-2">
          <div class="kbd self-start">hue-warning chroma-lo</div>
          <article class="card hue-warning chroma-lo">
            <div class="card-eyebrow">Heads up</div>
            <h3 class="card-title">Your streak is winding down</h3>
            <p class="card-body">
              No pressure — a two-minute review before midnight keeps your 18-day run
              alive. <a class="card-link" href="#">Read more ›</a>
            </p>
            <div class="card-foot">
              <span class="card-meta">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.3"></circle><line x1="8" y1="7.2" x2="8" y2="11.2"></line><circle cx="8" cy="4.8" r="0.55" fill="currentColor" stroke="none"></circle></svg>
                expires in 4h
              </span>
              <button class="card-btn" type="button">Keep it going</button>
            </div>
          </article>
        </div>

        <!-- success, bright -->
        <div class="flex flex-col gap-2">
          <div class="kbd self-start">hue-success chroma-hi</div>
          <article class="card hue-success chroma-hi">
            <div class="card-eyebrow">Milestone</div>
            <h3 class="card-title">Deck mastered!</h3>
            <p class="card-body">
              Every card in “Core 200” hit full recall. This one’s graduated from your
              daily queue. <a class="card-link" href="#">Read more ›</a>
            </p>
            <div class="card-foot">
              <span class="card-meta">
                <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="8" cy="8" r="6.3"></circle><line x1="8" y1="7.2" x2="8" y2="11.2"></line><circle cx="8" cy="4.8" r="0.55" fill="currentColor" stroke="none"></circle></svg>
                100% recall
              </span>
              <button class="card-btn" type="button">See summary</button>
            </div>
          </article>
        </div>
      </div>

      <p class="muted mt-4 max-w-[64ch] text-sm leading-relaxed">
        The <span class="kbd">card</span> component bakes in <span class="kbd">bg-lc-2</span>
        and <span class="kbd">border-lc-3</span>; the three articles differ only by their
        two seeder words. Toggle the theme — every <span class="kbd">lc</span> value
        inverts while keeping its relationship to the page. No <span class="kbd">dark:</span>
        classes anywhere.
      </p>
    </section>

    <!-- ── Per-hue chroma ────────────────────────────────────────────── -->
    <section class="mt-16">
      <h2 class="text-xl font-semibold tracking-tight">Per-hue chroma</h2>
      <p class="muted mt-1 max-w-[68ch] text-sm leading-relaxed">
        Hues don't reach perceived saturation at the same chroma — blue looks vivid at a
        low chroma, yellow needs much more. So each hue carries a
        <span class="kbd">--cscale-*</span> multiplier, and every color resolves its chroma
        as <span class="kbd">calc(base × scale)</span>. A given chroma stop then looks about
        equally saturated all the way around the wheel. The rows below are raw colors;
        the library maps semantic tokens onto angles like these.
      </p>

      <h3 class="muted mt-8 font-mono text-xs font-semibold tracking-wide uppercase">
        Mid-luminance fills — bg-lc-5
      </h3>
      <div class="mt-3 overflow-x-auto">
        <div class="grid min-w-[560px] grid-cols-[6rem_repeat(5,minmax(0,1fr))] gap-1.5">
          <div></div>
          {stops.map((s) => <div class="grid-head">chroma-{s}</div>)}
          {
            wheel.map((w) => (
              <Fragment>
                <div class="row-label">
                  <b>{w.name}</b>
                  <span>{w.deg}° · ×{w.cs}</span>
                </div>
                {stops.map((s) => (
                  <div class={`swatch hue-${w.name} chroma-${s} bg-lc-5`} />
                ))}
              </Fragment>
            ))
          }
        </div>
      </div>

      <h3 class="muted mt-8 font-mono text-xs font-semibold tracking-wide uppercase">
        As a surface — bg-lc-2 with text-lc-8
      </h3>
      <div class="mt-3 overflow-x-auto">
        <div class="grid min-w-[560px] grid-cols-[6rem_repeat(5,minmax(0,1fr))] gap-1.5">
          <div></div>
          {stops.map((s) => <div class="grid-head">chroma-{s}</div>)}
          {
            wheel.map((w) => (
              <Fragment>
                <div class="row-label">
                  <b>{w.name}</b>
                  <span>{w.deg}° · ×{w.cs}</span>
                </div>
                {stops.map((s) => (
                  <div class={`chip-cell hue-${w.name} chroma-${s} bg-lc-2`}>
                    <span class="text-lc-8 font-semibold">Aa gv 24</span>
                  </div>
                ))}
              </Fragment>
            ))
          }
        </div>
      </div>

      <h3 class="muted mt-10 font-mono text-xs font-semibold tracking-wide uppercase">
        The library's semantic hues
      </h3>
      <p class="muted mt-1 max-w-[64ch] text-sm leading-relaxed">
        Read off the wheel by angle. These are the multipliers baked into
        <span class="kbd">index.css</span> — override any <span class="kbd">--cscale-*</span>
        in a <span class="kbd">@theme</span> block to retune.
      </p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          semantic.map((h) => (
            <span class="kbd">
              {h.name} · {h.deg}° · ×{h.cs}
            </span>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
